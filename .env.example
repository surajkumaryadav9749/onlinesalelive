# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/onlinesalelive

# Admin Seed Credentials (used by npm run seed:admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@onlinesalelive.in
ADMIN_PASSWORD=your_secure_admin_password_here

# JWT Authentication Secret for Admin Session Cookie (minimum 32 characters in production)
AUTH_SECRET=your_jwt_secret_key_at_least_32_characters_long

# Affiliate Integration Configuration (Optional placeholders for authorized partner credentials)
AMAZON_ASSOCIATE_TAG=
FLIPKART_AFFILIATE_ID=
MYNTRA_AFFILIATE_ID=
AJIO_AFFILIATE_ID=
